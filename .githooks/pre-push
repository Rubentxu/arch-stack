#!/usr/bin/env bash
# pre-push hook — local-first verification before any push (ADR-025).
#
# Git invokes this hook with one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# This hook validates the EXACT non-deletion commits being pushed, not the
# ambient working tree (which may hold unrelated uncommitted changes). For
# each pushed commit it checks the commit out into a temporary worktree and
# runs the cheap tier of scripts/verify-local.sh against that worktree.
# Deletions (all-zero local sha) are skipped. Multiple refs are processed
# line by line. Every temporary worktree is removed from disk AND from git
# metadata on success or failure (trap + worktree remove --force + prune).
#
# It is intentionally cheap: the expensive --full tier (web + ADR-019
# benchmark regression vs origin/main) is the developer's pre-merge choice,
# not a per-push tax.
#
# Bypass with `git push --no-verify` only after human review.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -x "scripts/verify-local.sh" ]; then
    echo "pre-push: refusing push: scripts/verify-local.sh missing or not executable; install it (see ADR-025)" >&2
    exit 1
fi

ZERO_SHA="0000000000000000000000000000000000000000"
WT_ROOT="$(mktemp -d /tmp/pre-push.XXXXXX)"
WORKTREES=()
FAILED=0

cleanup() {
    for wt in "${WORKTREES[@]:-}"; do
        git worktree remove --force "$wt" >/dev/null 2>&1 || true
    done
    git worktree prune >/dev/null 2>&1 || true
    rm -rf "$WT_ROOT"
}
trap cleanup EXIT

# Each stdin line: local_ref local_sha remote_ref remote_sha
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue

    if [ "$local_sha" = "$ZERO_SHA" ]; then
        echo "pre-push: skipping deletion of ${local_ref}" >&2
        continue
    fi

    wt="$WT_ROOT/${local_ref#refs/heads/}"
    echo "pre-push: validating ${local_sha:0:12} (${local_ref})" >&2
    if ! git worktree add --detach "$wt" "$local_sha" >/dev/null 2>&1; then
        echo "pre-push: refusing push: cannot check out ${local_sha:0:12} for ${local_ref}" >&2
        FAILED=1
        continue
    fi
    WORKTREES+=("$wt")

    if (cd "$wt" && "$REPO_ROOT/scripts/verify-local.sh"); then
        echo "pre-push: ${local_sha:0:12} OK" >&2
    else
        echo "pre-push: verification FAILED for ${local_sha:0:12} (${local_ref})" >&2
        FAILED=1
    fi
done

if [ "$FAILED" -eq 1 ]; then
    echo "pre-push: refusing push: one or more pushed commits failed local verification" >&2
    exit 1
fi

exit 0
