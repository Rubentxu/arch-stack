#!/usr/bin/env bash
# commit-msg hook — trunk-base workflow enforcement.
#
# Validates every commit message against:
#   1. Conventional Commits (https://www.conventionalcommits.org/).
#   2. No AI attribution in subject, body, or footer.
#   3. Subject ≤ 72 chars.
#   4. No Co-Authored-By with a model name.
#
# Bypass with `git commit --no-verify` only after human review.
# Documented in `docs/git-trunk-base.md`.

set -euo pipefail

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Allow merge commits, fixup, squash, revert as-is — those are
# produced by git itself, never by humans or agents.
FIRST_LINE=$(printf '%s' "$MSG" | head -n1)
case "$FIRST_LINE" in
  Merge*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

# Allow reverts generated by `git revert` — they follow a known
# template and don't carry attribution.
if printf '%s\n' "$MSG" | grep -qE '^This reverts commit '; then
  exit 0
fi

err() {
  printf '\ncommit-msg hook failed:\n  %s\n\n' "$1" >&2
  printf 'See docs/git-trunk-base.md for the contract.\n' >&2
  exit 1
}

# 1. Subject must be non-empty.
if [ -z "$FIRST_LINE" ]; then
  err "subject is empty"
fi

# 2. AI attribution check FIRST so prefixing "Generated by AI:"
#    to a valid commit doesn't sneak through.
#
# Two sub-checks:
#   a) Any line beginning `Co-Authored-By:` (the git trailer form,
#      anchored at column 0) is forbidden outright — the project
#      has one human author.
#   b) Any mention of `Generated by <AI>` outside markdown inline
#      code (backticks) is forbidden.
ATTRIBUTION_OK=0
if printf '%s\n' "$MSG" | grep -qP '(?<!`)\bCo-Authored-By:'; then
  err "Co-Authored-By trailers are forbidden. The repository has
one author. Acknowledge help in the PR description, not git."
fi
if printf '%s\n' "$MSG" | grep -qP '(?i)\b(Generated by (an? )?(AI|GPT|Claude|MiniMax|Copilot|Gemini|LLM))\b(?!`)'; then
  err "AI attribution is forbidden in commit messages.

found a phrase like 'Generated by <AI>' in the message body.
Per the project's contract (docs/git-trunk-base.md), the human
owns the commit. If you need to acknowledge tooling, do it in
the PR body, not the commit log."
fi

# 4. Conventional Commit header: type(scope?): subject
#    type ∈ {feat,fix,docs,chore,refactor,test,perf,build,ci,style}
PATTERN='^(feat|fix|docs|chore|refactor|test|perf|build|ci|style)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s' "$FIRST_LINE" | grep -qE "$PATTERN"; then
  err "subject does not match conventional commits: $FIRST_LINE

expected: type(scope)?: subject
example:  feat(scope-gates): add must_hold invariant gate"
fi

# 5. Subject must not end with a period (project convention —
#    0% of existing commits use one, the conventional-commits spec
#    recommends against it).
if printf '%s' "$FIRST_LINE" | grep -qE '\.$'; then
  err "subject ends with a period — drop it"
fi

# 6. Subject length cap.
SUBJECT_LEN=${#FIRST_LINE}
if [ "$SUBJECT_LEN" -gt 72 ]; then
  err "subject is $SUBJECT_LEN chars (max 72)"
fi

exit 0
