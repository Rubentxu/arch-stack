{
  "capability": "extract.outline",
  "name": "ast-grep-outline",
  "version": "0.1.0",
  "command": ["sg", "--pattern", "type $T struct { $$$BODY }", "--lang", "go", "--json=stream", "{repoRoot}"],
  "requires": {
    "binaries": ["sg"],
    "minVersions": { "sg": "0.30.0" }
  },
  "output": {
    "type": "ast",
    "pattern": "\"(?<path>[^\"]+)\":\\{\"file\":\"(?<file>[^\"]+)\",\"range\":\\{\"start\":\\{\"line\":(?<line>\\d+)\\}\\}",
    "classification": "fact",
    "confidence": 0.85,
    "method": "heuristic-v1"
  }
}
