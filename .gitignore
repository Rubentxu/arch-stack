node_modules/
.DS_Store
*.log
.env
.env.local
dist/
build/
coverage/
.idea/
.vscode/
*.tsbuildinfo

# Local archived snapshots of older v2 docs (restore-only, not part of the source).
/.zip

# Local state — M0 creates ~/.local/share/archctl/, ~/.config/archctl/, etc.
/.local/share/archctl/
/.local/state/archctl/
/.cache/archctl/

# archctl scratch
/.archctl-rendered/

# Rust build artifacts (M2)
target/

# archctl Rust dev
.archctl/

# LadybugDB WAL checkpoint — runtime artifact, local to each clone
**/*.lbdb.wal.checkpoint

# archview workbench embedded into archctl (ADR-033). Generated by
# scripts/embed-view.sh from archview/dist. README.md stays tracked.
archctl/assets-view/*
!archctl/assets-view/README.md

# gentle-ai skill registry — auto-generated local index
.atl/

# SDDK working artifacts (per orchestrator v3.3 local-only policy).
# Working surface for SDD Kernel cycles — never commits, never reaches remote.
# Each cycle writes its own `sddk/{change}/` subdirectory with spec, design,
# tasks, apply-checkpoint, verify-report, debt-report, archive-report.
# Persisted to Engram under topic_key `sddk/{change}/*` for cross-machine recovery.
sddk/

# Also gitignore the companion read-overrides that make sddk/ visible to
# opencode tools despite the gitignore (v3.3 contract: locally readable).
.ignore

# SDDK closing reports (HTML closing-v*.html). Generated by the sddk-release
# phase from the per-cycle release-report.md. Working artifacts — never
# commit. (companion: not gitignored in `docs/reports/` so non-HTML files
# in that directory remain committable if added later.)
docs/reports/*.html

# --- SDDK Local-Only Artifact Policy (v3.3) ---
# Merged idempotently by sdd-kernel-init (2026-08-03).
# ADAPTATION (repo convention): the stock v3.3 template also ignores
# docs/ROADMAP.md, docs/adr/, docs/reports/, docs/metrics/. This repo
# deliberately COMMITS those (24 ADRs tracked; ADR-024 on main;
# `docs(cycle):` archive commits update ROADMAP), so those paths stay
# tracked and committable. Only the pure SDDK-generated surface is ignored:
# per-change folders, openspec change specs, and runtime state.
openspec/changes/
openspec/changes/archive/
**/apply-checkpoint.json
sddk-config.json
sddk.local.*
.sddk/
