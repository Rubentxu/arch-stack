{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-stack.local/schemas/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "seq",
    "timestamp",
    "eventType",
    "source",
    "producer",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "graphRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "payload": {}
  }
}
