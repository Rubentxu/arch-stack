{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-stack.local/schemas/context-bundle.schema.json",
  "title": "ContextBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "graphRevision",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "task": {
      "type": "string"
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 0
    },
    "budgetTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "omittedCount": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "includedBecause"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "includedBecause": {
            "type": "string"
          },
          "pathFromSeed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "freshness": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
