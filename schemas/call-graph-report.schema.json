{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archctl.dev/schemas/call-graph-report.schema.json",
  "title": "Call Graph Report",
  "description": "archctl code call-graph output (schemaVersion 1.0)",
  "type": "object",
  "required": ["schemaVersion", "project", "nodes", "edges", "errors"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": {
      "type": "object",
      "required": ["root", "filesScanned", "languages", "durationMs"],
      "properties": {
        "root": { "type": "string" },
        "filesScanned": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "object",
          "description": "Language → file-count map (e.g. {\"rust\": 30, \"typescript\": 12}).",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_key", "kind", "language", "file", "line", "name", "confidence"],
        "properties": {
          "canonical_key": { "type": "string", "pattern": "^[a-z]+:.+:[^:]+:[0-9]+$" },
          "kind": { "enum": ["function", "method", "closure"] },
          "language": { "enum": ["rust", "typescript", "python", "go", "java", "kotlin"] },
          "file": { "type": "string" },
          "contentHash": { "type": "string", "description": "sha256:<hex> of file content (D2 identity input)" },
          "line": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "fqName": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "parent": { "type": ["string", "null"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_key", "caller", "callee", "file", "line", "kind", "messageKind", "confidence"],
        "properties": {
          "canonical_key": { "type": "string" },
          "caller": { "type": "string" },
          "callee": { "type": "string" },
          "file": { "type": "string" },
          "contentHash": { "type": "string", "description": "sha256:<hex> of file content (D2 identity input)" },
          "line": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["direct_call", "method_call", "chained_call"] },
          "messageKind": { "enum": ["sync_call", "async_call", "return"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy", "path", "message"],
        "properties": {
          "strategy": { "type": "string" },
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
