{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassDiagramReport",
  "description": "UML class-diagram projection report — class/interface/trait/enum/record nodes + extends/implements/composes edges",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "filesScanned": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "required": ["root", "filesScanned", "languages", "durationMs"],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_key": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["class", "interface", "trait", "enum", "record"]
          },
          "language": {
            "type": "string",
            "enum": ["rust", "typescript", "python"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "member_kind": { "type": "string" },
                "signature": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
              },
              "required": ["name", "member_kind", "signature", "line"],
              "additionalProperties": false
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["canonical_key", "kind", "language", "file", "line", "name", "members", "confidence"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_key": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "predicate": {
            "type": "string",
            "enum": ["extends", "implements", "composes"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["canonical_key", "source", "target", "predicate", "file", "line", "confidence"],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["path", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "project", "nodes", "edges", "errors"],
  "additionalProperties": false
}
